<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Framesaver</AssemblyName>
    <RootNamespace>Framesaver</RootNamespace>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Version>$(AssemblyVersion)</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Configurations>Debug;Release</Configurations>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!--
      The stock SPT template assumes the project sits in <SPT install>\Development\<Mod>\.
      This project lives in F:\SPT\Mods\Framesaver while the install is F:\SPT\Base,
      so SptDir is spelled out rather than inferred. Change this one line if either moves.
    -->
    <!--
      Must point at an install that has been launched at least once: SPT deobfuscates Assembly-CSharp.dll
      on first launch, keeping the original as .spt-bak. Against a never-launched install the shipped DLL
      still has raw obfuscated type names and five of our targets do not resolve.
    -->
    <!--
      Normalised, not just joined. Unresolved, this prints as
      "...\Framesaver\..\..\SPT4.0.13\..." in the deploy line, and the whole
      point of that line is to name WHICH install unambiguously - there are two
      on this machine and only this one is ever deployed to.
    -->
    <SptDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\SPT4.0.13'))</SptDir>
    <ManagedDir>$(SptDir)\EscapeFromTarkov_Data\Managed</ManagedDir>
    <BepInExDir>$(SptDir)\BepInEx</BepInExDir>

    <!--
      tests\ holds its own project, and the SDK's default **\*.cs glob would otherwise compile it and
      its generated obj\ assembly-info into this assembly - which fails with duplicate-attribute errors
      rather than anything that names the cause. Adding a test broke the build until this line existed.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>$(BepInExDir)\plugins\spt\spt-reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-common">
      <HintPath>$(BepInExDir)\plugins\spt\spt-common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Comfort.Common.Singleton<GameWorld> -->
    <Reference Include="Comfort">
      <HintPath>$(ManagedDir)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AnimationSystem.Types">
      <HintPath>$(ManagedDir)\AnimationSystem.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityEngine.Input. Needed because we test keybinds ourselves rather than through
         KeyboardShortcut.IsDown, which refuses to fire while any other key is held. -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- NavMesh.SamplePosition, for validating a computed grid position before handing it to
         BotCreationDataClass.AddPosition - see DistanceGridSpawn.cs. -->
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(ManagedDir)\UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Deploying is opt-in. This target used to copy unconditionally, which made
    every build a deploy - so a verification build of a compile fix replaced a
    binary another agent had declared frozen, and nobody had broken any rule.
    A freeze that any build can break is a note, not a control.

    Both outcomes are announced, because the failure mode this replaces is a
    silent overwrite and the obvious wrong fix is a silent no-op: running the
    game against a stale plugin while believing you had just built it.

      dotnet build -c Release                     compiles only
      dotnet build -c Release -p:Deploy=true      compiles and deploys
  -->
  <!--
    Refuses to deploy a binary built from uncommitted sources.

    The stamp in AssemblyInformationalVersion is HEAD at build time, and the SDK
    writes it whether or not the tree is clean - so a deploy from a dirty tree
    installs a binary whose stamp names a commit whose SOURCE IS NOT WHAT IS
    INSIDE IT. Every control we have downstream reads that stamp: the gate
    compares it, the rollback rule exists because a rebuild stamps differently,
    and "the install matches GO" is a statement about it. A stamp that can be
    wrong makes all three statements about the wrong thing.

    Compiling dirty is normal and stays allowed - that is most of a working day.
    Only the copy into plugins is gated, because that is the step that makes a
    lie durable.

    If git cannot run we REFUSE, and name the opt-out. It used to warn and
    proceed, which was wrong for a reason only visible once the branch was
    exercised: **SourceLink does not shell out to git.** It reads .git directly,
    so a missing git binary still produces a correctly-formed stamp naming HEAD -
    a plausible stamp over a tree nothing could check. A warning in a build log
    is exactly the finding reported without a disposition that gets remembered
    as handled.

    That paragraph used to end "the dangerous case is not an unstamped binary".
    Both cases are dangerous, and most of the corpus - 52 of 55 logs across two
    installs - carries commit:"" and cannot be tied to a build at all.

    BUT DO NOT READ THIS GATE AS THE FIX FOR THOSE 52. A blank commit in a log
    has TWO causes and they are not distinguishable from the log:

      1. the assembly was never stamped - Framesaver-20260728-0027 carries a
         bare "0.1.0", so SourceLink was not producing a sha at all; and
      2. the assembly WAS stamped but the telemetry header did not yet read it -
         only the two 20260728-header-* artifacts emit a "commit" field, so
         every earlier binary wrote a header that could not carry one.

    Both landed on 2026-07-28, hours apart. This gate prevents (1) only. (2) was
    fixed by the header work and no build check could have caught it. Verified by
    reading ProductVersion and the #US heap of the artifacts themselves rather
    than inferred from the dates.

    -p:AllowUnverifiedDeploy=true is the escape hatch, so someone building
    without git types one flag and knows precisely what they gave up. An
    explicit act rather than a line that scrolls past.
  -->
  <!--
    DependsOnTargets is load-bearing, not tidiness: $(SourceRevisionId) is set by
    InitializeSourceControlInformation, and without this the stamp check reads
    empty and REFUSES EVERY DEPLOY - including the good ones. Found by running
    the control rather than only the falsification: the deliberately-broken build
    refused, and so did the healthy one, so the "it fires" result meant nothing.
  -->
  <Target Name="RefuseDirtyDeploy" BeforeTargets="PostBuild" Condition="'$(Deploy)' == 'true'"
          DependsOnTargets="InitializeSourceControlInformation">
    <Exec Command="git status --porcelain -- *.cs Patches/*.cs Framesaver.csproj"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" StandardOutputImportance="low"
          ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="FramesaverDirty" />
      <Output TaskParameter="ExitCode" PropertyName="FramesaverGitExit" />
    </Exec>

    <Error Condition="'$(FramesaverGitExit)' != '0' And '$(AllowUnverifiedDeploy)' != 'true'"
           Text="Framesaver: refusing to deploy. git could not run, so the clean-tree check was SKIPPED, not passed - and SourceLink reads .git directly, so this binary still carries a plausible-looking stamp that nothing has checked against its source. Re-run with -p:AllowUnverifiedDeploy=true if you accept that." />

    <!--
      Gated on the git failure as well as the flag, because the flag alone said
      something false. With git working and the tree dirty, one build emitted
      this warning AND the refusal below - and the refusal cannot fire unless
      the check ran, so the control refuted its own warning in a single run.

      The live case was worse than the contradiction: clean tree, git present,
      flag set, deploying while telling the operator their binary is unverified
      when it is fully verified. A warning that is wrong in ordinary use is one
      people learn to scroll past, and the habit carries to the run where it was
      true. Same argument as the DRIP note in COORDINATION.md, arriving inside a
      control built the same evening.
    -->
    <Warning Condition="'$(AllowUnverifiedDeploy)' == 'true' And '$(FramesaverGitExit)' != '0'"
             Text="Framesaver: AllowUnverifiedDeploy is set and git could not run, so the clean-tree check did not run. This binary's stamp may not describe its source." />

    <!--
      An unstamped deploy is refused outright. The SDK writes the sha into
      AssemblyInformationalVersion from $(SourceRevisionId); if that is empty
      the binary ships with commit:"" and every log it writes is anonymous.
      Nothing downstream can recover it later - not the gate, not a rollback,
      not an analysis - which is why this is worth failing a build over and the
      dirty-tree case is only worth failing a DEPLOY over.

      Same escape hatch rather than a second one, so there is one flag to learn
      and one habit to break. Building the mod outside a git checkout is a real
      thing a stranger might do.
    -->
    <Error Condition="'$(SourceRevisionId)' == '' And '$(AllowUnverifiedDeploy)' != 'true'"
           Text="Framesaver: refusing to deploy. This assembly carries NO commit stamp, so every telemetry log it writes will read commit:&quot;&quot; and can never be tied back to a build - 22 of the 25 logs already in the corpus are in exactly that state and their cross-log comparisons are unrecoverable. Build from a git checkout, or re-run with -p:AllowUnverifiedDeploy=true if you accept anonymous logs." />

    <Warning Condition="'$(AllowUnverifiedDeploy)' == 'true' And '$(SourceRevisionId)' == ''"
             Text="Framesaver: AllowUnverifiedDeploy is set and there is no commit stamp. Logs from this binary will read commit:&quot;&quot; and cannot be attributed to a build." />

    <Error Condition="'$(FramesaverGitExit)' == '0' And '$(FramesaverDirty)' != ''"
           Text="Framesaver: refusing to deploy. Compiled sources differ from HEAD, so the build stamp would name a commit this binary was not built from:%0A$(FramesaverDirty)%0ACommit first, then rebuild - the stamp is read from git HEAD at build time." />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy Condition="'$(Deploy)' == 'true'"
          SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\" />
    <!--
      Both branches name the install, and the deploy branch names the stamp.

      There are TWO playable installs on this machine - F:\SPT\SPT4.0.13 (SAIN,
      BigBrain, Waypoints, LootingBots) and F:\SPT\Base (no AI mods) - each with
      its own Framesaver-logs directory, and they share no log filenames. Only
      SptDir is ever deployed to. For a week I announced "the install matches the
      gate" with one md5, which was true of one of two installs and nobody could
      have questioned it, because no artefact wrote down which one it meant.

      This line did name the path. My summaries paraphrased it into "the
      install", so the scope was recorded and then discarded by a human. Naming
      it in BOTH branches, with the stamp, makes the announcement a copy rather
      than a retelling - which is the only version that cannot lose the noun.
    -->
    <Message Condition="'$(Deploy)' == 'true'" Importance="high"
             Text="Framesaver: DEPLOYED $(InformationalVersion) to $(BepInExDir)\plugins\ (this install only; other installs are untouched)" />
    <Message Condition="'$(Deploy)' != 'true'" Importance="high"
             Text="Framesaver: built $(InformationalVersion), NOT deployed. -p:Deploy=true copies into $(BepInExDir)\plugins\" />
  </Target>

</Project>
